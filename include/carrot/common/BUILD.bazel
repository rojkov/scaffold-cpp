    name = "extension_registry_lib",
    hdrs = ["extension_registry.hh"],
    visibility = ["//visibility:public"],
    deps = [
        "//include/carrot/event:dispatcher_interface",
    ],
)

carrot_cc_library(
    name = "types_lib",
    hdrs = [
        "result_receiver.hh",
        "types.hh",
