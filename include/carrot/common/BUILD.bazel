    deps = [
        ":types_lib",
    ],
)

carrot_cc_library(
    name = "wire_protocol_lib",
    hdrs = ["wire_protocol.hh"],
    visibility = ["//visibility:public"],
    deps = [
        ":types_lib",
    ],
)

carrot_cc_library(
    name = "connection_pool_lib",
    hdrs = ["connection_pool.hh"],
    visibility = ["//visibility:public"],
    deps = [
        ":types_lib",
    ],
)
